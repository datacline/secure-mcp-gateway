{
  "name": "@datacline/smcp",
  "version": "0.1.0",
  "description": "CLI for Secure MCP Gateway workflows",
  "homepage": "https://github.com/datacline/secure-mcp-gateway/tree/main/packages/smcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacline/secure-mcp-gateway.git",
    "directory": "packages/smcp"
  },
  "bugs": {
    "url": "https://github.com/datacline/secure-mcp-gateway/issues"
  },
  "keywords": [
    "mcp",
    "cli",
    "secure-mcp-gateway",
    "smcp"
  ],
  "license": "MIT",
  "author": "Datacline",
  "type": "module",
  "main": "./dist/smcp.cjs",
  "module": "./dist/smcp.mjs",
  "exports": {
    ".": {
      "import": "./dist/smcp.mjs",
      "require": "./dist/smcp.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "smcp": "dist/smcp.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true,
  "scripts": {
    "smcp": "node ./bin/smcp.js",
    "start": "node ./bin/smcp.js",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "node ./bin/smcp.js --help",
    "commands": "node ./bin/smcp.js commands"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
